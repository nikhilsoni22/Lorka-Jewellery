API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
# Used for metadataBase/OpenGraph tags and the generated sitemap.xml — set to the real deployed
# site URL in production (e.g. https://lorkajewellers.com), no trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Google Maps JavaScript API key (Places + Geocoding APIs enabled) used for checkout address
# autocomplete. Restrict this key by HTTP referrer in the Google Cloud Console to your site's
# domain(s) — it is shipped to the browser since Maps JS requires a client-side key.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
