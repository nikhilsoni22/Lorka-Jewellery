# Server
NODE_ENV=development
PORT=5000

# Database
MONGO_URI=mongodb+srv://<user>:<pass>@<cluster>/lorka_jewellers?appName=Cluster0

# JWT secrets (use long random strings in production)
JWT_ACCESS_SECRET=change-me-access-secret-min-16-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-16-chars
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_TOKEN_REMEMBER_TTL_DAYS=30
RESET_TOKEN_TTL_MIN=30

# CORS / clients
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
WEBSITE_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
COOKIE_DOMAIN=

# Seed super-admin (used by `pnpm seed:admin`)
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@lorka.com
SEED_ADMIN_PASSWORD=Admin@12345

# Razorpay (get keys from https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=change-me-razorpay-key-secret

# Gmail SMTP (order confirmation emails). Leave SMTP_USER/SMTP_PASS unset to just
# log emails to the console instead of sending them. SMTP_PASS must be a Gmail
# "App Password" (https://myaccount.google.com/apppasswords), not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Lorka Jewellers <your-address@gmail.com>
