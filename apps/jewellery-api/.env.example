# Server
NODE_ENV=development
PORT=5000

# Database
MONGO_URI=mongodb+srv://<user>:<pass>@<cluster>/lorka_jewellers?appName=Cluster0

# JWT secrets (use long random strings in production)
JWT_ACCESS_SECRET=change-me-access-secret-min-16-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-16-chars
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_TOKEN_REMEMBER_TTL_DAYS=30
RESET_TOKEN_TTL_MIN=30

# CORS / clients — in production, CORS_ORIGINS must list the exact deployed website + admin
# URLs (comma-separated, no trailing slash). COOKIE_DOMAIN should be the shared parent domain
# (e.g. ".lorkajewellers.com") once the API/website/admin are all subdomains of one custom
# domain — see the comment on COOKIE_DOMAIN in src/config/env.ts for why this matters.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
WEBSITE_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
COOKIE_DOMAIN=

# Seed super-admin (used by `pnpm seed:admin`)
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@lorka.com
SEED_ADMIN_PASSWORD=Admin@12345

# Razorpay — optional, and only used to seed the database the very first time the settings
# document is created. Day-to-day, keys are managed from Admin panel → Settings → Payment
# Gateway (get them from https://dashboard.razorpay.com/app/keys), not from here.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Cloudinary (get these from the "Product Environment Credentials" card at
# https://console.cloudinary.com/ after creating a free account). Product/banner images upload
# straight here so they survive host restarts and redeploys — the API's own disk does not.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Gmail SMTP (order confirmation emails). Leave SMTP_USER/SMTP_PASS unset to just
# log emails to the console instead of sending them. SMTP_PASS must be a Gmail
# "App Password" (https://myaccount.google.com/apppasswords), not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Lorka Jewellers <your-address@gmail.com>
